# Frontend (Vite). These VITE_* values are compiled into the public browser bundle.
# Only the Supabase project URL and anon/publishable key belong here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Vite dev-server proxy target for /api/* calls. Use the Supabase Functions base URL.
VITE_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# The following are Supabase Edge Function secrets, configured with
# `supabase secrets set` (or the Supabase dashboard), never in VITE_* variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
PUBLIC_SITE_URL=https://ab16clothing.co.uk

# Payments: configure only if the corresponding Edge Functions are deployed.
STRIPE_SECRET_KEY=REPLACE_WITH_SERVER_SIDE_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET
STRIPE_MASTERING_PRICE_SINGLE=REPLACE_WITH_STRIPE_PRICE_ID
STRIPE_MASTERING_PRICE_PACK5=REPLACE_WITH_STRIPE_PRICE_ID
STRIPE_MASTERING_PRICE_PACK10=REPLACE_WITH_STRIPE_PRICE_ID
# Dedicated staging webhook only: set to false there; production defaults to true.
STRIPE_EXPECT_LIVE_MODE=true

# Store fulfilment and email (store Stripe webhook / Printful webhook functions).
PRINTFUL_API_KEY=REPLACE_ME
PRINTFUL_WEBHOOK_SIGNING_SECRET=REPLACE_ME
RESEND_API_KEY=re_REPLACE_ME
ADMIN_ORDER_EMAIL=orders@example.com
FROM_EMAIL=orders@example.com

# Optional publication function setting.
SITE_URL=https://YOUR_PRODUCTION_SITE_DOMAIN
