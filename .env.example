# Environment Variables — AB16 Clothing × Jamie G Music

# Supabase frontend (public anon key only)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe publishable key (client-side, e.g. for Stripe.js if needed)
# For clothing checkout the key is only used in Edge Functions (sk_test_/sk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Supabase server-side (used in edge functions only, NOT exposed to frontend)
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUBLIC_SITE_URL=https://ab16clothing.co.uk

# Stripe (set as Supabase Edge Function secrets via `npx supabase secrets set`)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Printful
PRINTFUL_API_KEY=your-printful-api-key
PRINTFUL_WEBHOOK_SECRET=your-printful-webhook-signing-secret

# Email provider — Resend
RESEND_API_KEY=re_xxx
ADMIN_ORDER_EMAIL=orders@example.com
FROM_EMAIL=orders@ab16clothing.co.uk
